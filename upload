#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
KEY="$ROOT_DIR/digitalocean"
USER="deploy"
HOST="68.183.27.130"
DEST="kimballbradford-com"
IMAGE_TAR="/tmp/kb-images.tar"

info()  { printf "\033[1;34m==>\033[0m %s\n" "$*"; }
error() { printf "\033[1;31mERROR:\033[0m %s\n" "$*" >&2; }

cleanup() { rm -f "$IMAGE_TAR"; }
trap cleanup EXIT

if [ ! -f "$KEY" ]; then
  error "SSH key not found at $KEY"
  exit 1
fi

SSH_OPTS=(-i "$KEY" -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR)

# --- First-time droplet setup ---
if ! ssh "${SSH_OPTS[@]}" "$USER@$HOST" "mkdir -p $DEST" 2>/dev/null; then
  info "Setting up droplet (install Docker, create deploy user)..."
  ssh "${SSH_OPTS[@]}" root@"$HOST" "
    set -e
    id deploy &>/dev/null || adduser --disabled-password --gecos '' deploy
    if ! command -v docker &>/dev/null; then
      curl -fsSL https://get.docker.com | sh
    fi
    if ! getent group docker &>/dev/null; then
      groupadd docker
    fi
    usermod -aG docker deploy
    mkdir -p /home/deploy/.ssh
    chmod 700 /home/deploy/.ssh
  "
  ssh "${SSH_OPTS[@]}" root@"$HOST" "cat >> /home/deploy/.ssh/authorized_keys" < "$ROOT_DIR/digitalocean.pub"
  ssh "${SSH_OPTS[@]}" root@"$HOST" "chown -R deploy:deploy /home/deploy/.ssh && chmod 600 /home/deploy/.ssh/authorized_keys"
  ssh "${SSH_OPTS[@]}" "$USER@$HOST" "mkdir -p $DEST" || {
    error "Still can't connect as $USER"
    exit 1
  }
fi

# --- Build images locally ---
info "Building Docker images locally..."
cd "$ROOT_DIR"
docker compose build

# Find built image tags
IMAGES=$(docker image ls --format '{{.Repository}}:{{.Tag}}' | grep 'kimballbradford-com' | tr '\n' ' ')
if [ -z "$IMAGES" ]; then
  error "No built images found (expected tags containing 'kimballbradford-com')"
  exit 1
fi
info "Built images: $IMAGES"

info "Saving images to $IMAGE_TAR..."
docker save $IMAGES -o "$IMAGE_TAR"

# --- Stop services on droplet ---
info "Stopping services on droplet..."
ssh "${SSH_OPTS[@]}" "$USER@$HOST" "cd $DEST && docker compose down 2>/dev/null; docker compose -f docker-compose.yml -f docker-compose.prod.yml down 2>/dev/null; true"

# --- Upload project files ---
info "Uploading project files..."
rsync -avz --delete \
  --exclude '.git/' \
  --exclude '.gitmodules' \
  --exclude 'data/' \
  --exclude '.env' \
  --exclude 'digitalocean' \
  --exclude 'digitalocean.pub' \
  --exclude 'node_modules/' \
  -e "ssh -i $KEY" \
  "$ROOT_DIR/" "$USER@$HOST:$DEST/"

# --- Upload image tar ---
info "Uploading Docker images..."
scp -i "$KEY" "$IMAGE_TAR" "$USER@$HOST:/tmp/"

# --- Load images and start ---
info "Loading images on droplet..."
ssh "${SSH_OPTS[@]}" "$USER@$HOST" "docker load -i /tmp/kb-images.tar && rm /tmp/kb-images.tar"

info "Ensuring data directories..."
ssh "${SSH_OPTS[@]}" "$USER@$HOST" "mkdir -p $DEST/data/live-documents"

info "Checking .env..."
HAS_PROD_ENV=$(ssh "${SSH_OPTS[@]}" "$USER@$HOST" "grep -q '^ACME_EMAIL=' $DEST/.env 2>/dev/null && echo 1 || echo 0")
HAS_DOMAIN=$(ssh "${SSH_OPTS[@]}" "$USER@$HOST" "grep -q '^DOMAIN=' $DEST/.env 2>/dev/null && echo 1 || echo 0")

if [ "$HAS_DOMAIN" = "0" ]; then
  info "No DOMAIN found in .env — uploading placeholder"
  ssh "${SSH_OPTS[@]}" "$USER@$HOST" "cat > $DEST/.env << 'ENVEOF'
DOMAIN=localhost
COLLABEDIT_JWT_KEY=change-me-to-32-bytes-or-more
ENVEOF"
fi

info "Starting services..."
if [ "$HAS_PROD_ENV" = "1" ]; then
  ssh "${SSH_OPTS[@]}" "$USER@$HOST" "cd $DEST && docker compose -f docker-compose.yml -f docker-compose.prod.yml up --no-build -d"
else
  ssh "${SSH_OPTS[@]}" "$USER@$HOST" "cd $DEST && docker compose up --no-build -d"
fi

DOMAIN_VAL=$(ssh "${SSH_OPTS[@]}" "$USER@$HOST" "grep '^DOMAIN=' $DEST/.env | cut -d= -f2")

echo ""
info "Done! Site should be live at:"
echo "  http://${DOMAIN_VAL:-$HOST}/live-documents/"
[ "$HAS_PROD_ENV" = "1" ] && echo "  https://${DOMAIN_VAL:-$HOST}/live-documents/"
